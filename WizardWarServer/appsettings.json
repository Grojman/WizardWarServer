{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/wizardwar-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "WizardWarServer"
    }
  },
  "AllowedHosts": "*",
  "ServerSettings": {
    "AllowedOrigins": [],
    "MaxMessageSizeBytes": 65536,
    "MessageRateLimitPerSecond": 20,
    "ConnectionRateLimitPerMinute": 30,
    "MaxSuggestionLength": 2000,
    "MinPlayersPerGame": 1,
    "MaxPlayersPerGame": 8,
    "SeedCardDataIfMissing": true,
    "DataDirectory": "Data/Decks"
  }
}
